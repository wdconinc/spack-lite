# Single source of truth for the Pyodide / Python versions used
# in both deploy.yml and test.yml.  Bump these two values together whenever
# upgrading Pyodide, then verify:
#   PYODIDE_VERSION  – must match PYODIDE_CDN in worker.js
#   PYTHON_VERSION   – must match the Python bundled in that Pyodide release
#                      (3.11 for 0.25.x, 3.12 for 0.27.x, 3.13 for 0.29.x, …)
PYODIDE_VERSION=0.29.4
PYTHON_VERSION=3.13
