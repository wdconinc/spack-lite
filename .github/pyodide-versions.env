# Single source of truth for the Pyodide / Python / clingo-branch versions used
# in both deploy.yml and test.yml.  Bump these three values together whenever
# upgrading Pyodide, then verify:
#   PYODIDE_VERSION  – must match PYODIDE_CDN in worker.js
#   PYTHON_VERSION   – must match the Python bundled in that Pyodide release
#                      (3.11 for 0.25.x, 3.12 for 0.26.x, …)
#   CLINGO_BRANCH    – wip-20 branch of the clingo Pyodide wheel build scripts
PYODIDE_VERSION=0.26.4
PYTHON_VERSION=3.12
CLINGO_BRANCH=wip-20
